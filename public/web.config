<?xml version="1.0" encoding="UTF-8"?>
<!--
  Configuración de IIS para RefundyTax web.

  Se copia tal cual a dist/ y de ahí a la carpeta publicada. No lo edites en
  dist/ ni en el servidor: se sobrescribe en cada publicación.

  La app es una SPA con React Router: el servidor no conoce /tramites ni
  /configuracion. Cuando IIS no encuentra el archivo, en vez de dar 404
  ejecuta index.html y deja que React Router resuelva la ruta. Sin esto,
  un F5 sobre cualquier pantalla que no sea la raíz devuelve 404.

  Usa <httpErrors> y no <rewrite> porque los servidores de la intranet no
  tienen instalado el módulo URL Rewrite: una sección <rewrite> ahí produce
  un 500.19 antes de servir nada. Es el mismo esquema que ToolBox Web.
-->
<configuration>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
